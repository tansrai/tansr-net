<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PackageId>Tansr.Sdk</PackageId>
    <Description>Tansr Serve 原生 .NET 协议、会话与终端能力 SDK。</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tansr.Sdk.Windows" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../contract/sdk2-ext-v1.schema.json" LogicalName="Tansr.Sdk.Protocol.sdk2-ext-v1.schema.json" />
    <EmbeddedResource Include="Cache/Contract/sdk2-cache-v1.schema.json" LogicalName="Tansr.Sdk.Cache.sdk2-cache-v1.schema.json" />
    <EmbeddedResource Include="Terminal/Contract/terminal-services-v1.schema.json" LogicalName="Tansr.Sdk.Terminal.terminal-services-v1.schema.json" />
    <InternalsVisibleTo Include="Tansr.Sdk.Tests" />
  </ItemGroup>
</Project>
